{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "run-tempo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // "/" would otherwise be served straight from out/index.html, skipping the
    // locale redirect. Everything else either matches an asset (served directly
    // and free) or falls through to the Worker when nothing matches.
    "run_worker_first": ["/"]

    // Deliberately no "not_found_handling": it resolves before the Worker runs,
    // so an unprefixed path like /blog would render the 404 page instead of
    // being redirected to /ja/blog/. worker/index.ts serves 404.html instead.
  },
  "observability": { "enabled": true }
}
